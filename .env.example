# ────────────────────────────────────────────────────────────────────
# Server-side secrets (Vercel project → Settings → Environment Variables)
# ────────────────────────────────────────────────────────────────────
# These are read by serverless API functions. They are NEVER exposed
# to the browser.

GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Personal Intelligence / RealtyFlow server-to-server mentor summary.
# Use a dedicated random bearer secret and a server-only Supabase service key.
OLIVIA_MENTOR_API_KEY=your-dedicated-mentor-api-key
OLIVIA_MENTOR_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional server URL override. If omitted, VITE_SUPABASE_URL is used.
# SUPABASE_URL=https://your-project-ref.supabase.co

# ────────────────────────────────────────────────────────────────────
# Browser-side config (prefixed with VITE_ so Vite exposes them)
# ────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: pin a Gemini key into the build for local dev only.
# Leave blank in production — the serverless proxy is preferred.
# VITE_GEMINI_API_KEY=
